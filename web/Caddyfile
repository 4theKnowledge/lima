# SPA fallback: unknown paths serve index.html so React Router client-side
# routes survive page refresh. Binds to Railway's injected $PORT (default 80
# for local `docker run`).
{
	auto_https off
	admin off
}

:{$PORT:80} {
	root * /usr/share/caddy
	encode gzip
	try_files {path} /index.html
	file_server
}
