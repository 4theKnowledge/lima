# .railwayignore is used by `railway up` for its upload context.
# It takes precedence over .gitignore.
#
# We want the same excludes as .gitignore EXCEPT db/land_read.duckdb, which
# is the read snapshot that Dockerfile.api COPYs into the image. Without
# this file, the build fails at COPY db/land_read.duckdb: not found.

# --- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# --- Secrets
.env
.env.local

# --- Ingest inputs (not needed at deploy time)
cache/

# --- Node / frontend (has its own service)
node_modules/
web/dist/
web/.vite/
web/stats.html
web/.env
web/.env.local
web/.env.*.local

# --- Build / cache
*.tsbuildinfo
.eslintcache
.parcel-cache/

# --- OS / editor
.DS_Store
.idea/
.vscode/
web/.idea/
web/.vscode/

# --- Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Coverage
coverage/
.nyc_output/

# --- DuckDB write DB and WAL/tmp (we only need the read snapshot).
# NOTE: NOT ignoring db/land_read.duckdb — that's what we're shipping.
db/land.duckdb
db/*.duckdb.wal
db/*.duckdb.tmp
