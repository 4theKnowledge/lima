# API service: FastAPI + baked-in DuckDB snapshot.
#
# The snapshot db/land_read.duckdb (~139 MB) is copied into the image at
# build time. Refresh data = rebuild snapshot locally + railway up again.
# The snapshot is gitignored, so use `railway up` (uploads working tree)
# rather than GitHub-connected deploys.

FROM python:3.11-slim

# uv for fast, lockfile-driven installs.
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /usr/local/bin/uv

WORKDIR /app

# Install deps first so code changes don't bust the layer cache.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# Copy application code.
COPY api ./api
COPY scoring ./scoring
COPY db ./db
COPY ingest/settings.py ./ingest/settings.py

# Snapshot no longer baked in — downloaded from $SNAPSHOT_URL at container
# startup (see api/main.py lifespan). Keeps image small and lets us deploy
# from GitHub instead of needing `railway up`.

# Pre-install DuckDB extensions into the image so the read-only runtime
# connection can LOAD them without needing to INSTALL. INSTALL requires a
# writable connection, which we don't have at runtime.
RUN uv run --no-sync python -c "import duckdb; con = duckdb.connect(':memory:'); con.execute('INSTALL spatial'); con.execute('INSTALL h3 FROM community')"

ENV PYTHONUNBUFFERED=1

# Railway injects $PORT. Default to 8010 for local `docker run` testing.
CMD uv run --no-sync uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8010}
